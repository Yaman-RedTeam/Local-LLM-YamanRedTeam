# Copy this file to .env and adjust as needed.
# .env is gitignored — never commit real secrets.

# Ollama model to use. Any model pulled into your local Ollama instance works.
# Uncensored/open options: dolphin-llama3, dolphin-mixtral, dolphin-phi
OLLAMA_MODEL=dolphin-llama3

# Base URL of your local Ollama server.
OLLAMA_HOST=http://localhost:11434

# Web server bind address/port for the FastAPI app.
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=false

# Request tuning.
REQUEST_TIMEOUT_SECONDS=120
MAX_MESSAGE_LENGTH=6000
MAX_HISTORY_MESSAGES=40
